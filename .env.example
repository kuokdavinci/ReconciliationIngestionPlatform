# Application Configuration
# Copy this file to .env and update values for your environment

# MongoDB configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_password
APP_MONGODB_URL=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@localhost:27017/reconciliation?authSource=admin
APP_DB_NAME=reconciliation

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reconciliation
APP_POSTGRES_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Logging configuration
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# Application name
APP_APP_NAME=reconciliation-ingestion
APP_STRICT_MAPPING_APPROVAL_ENABLED=true
APP_UPLOAD_TMP_DIR=./scratch/temp_uploads

# Scheduler ownership and business date. The demo stack uses Airflow; switch
# to apscheduler only for an explicit rollback.
APP_AUTOMATION_ORCHESTRATOR=airflow
APP_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# Airflow 3.3 single-machine control plane
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_airflow_db_password
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace_with_airflow_admin_password
AIRFLOW_JWT_SECRET=replace_with_at_least_64_random_characters_shared_by_all_airflow_services
# Use "none" for a manual-only pilot, then restore the production cron at cutover.
AIRFLOW_GLOBAL_SCHEDULE=none
AIRFLOW_STREAM_TIMEOUT_SECONDS=7200
# Set to 0 for a deterministic manual-retry demo; set to 1 to keep Airflow's
# five-minute native retry as a fallback when the operator does nothing.
AIRFLOW_TASK_RETRIES=0
AIRFLOW_TASK_RETRY_DELAY_SECONDS=300
APP_AIRFLOW_BASE_URL=http://airflow-api-server:8080
APP_AIRFLOW_DAG_ID=reconciliation_ingestion
APP_AIRFLOW_USERNAME=${AIRFLOW_ADMIN_USERNAME}
APP_AIRFLOW_PASSWORD=${AIRFLOW_ADMIN_PASSWORD}
APP_AIRFLOW_REQUEST_TIMEOUT_SECONDS=15

# SFTP configuration (for Docker Compose and file ingestion)
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=foo
SFTP_PASS=your_sftp_password
SFTP_REMOTE_DIR=/upload

# Ingestion Performance Tuning
APP_INGEST_BATCH_SIZE=20000
APP_INGEST_WRITE_WORKERS=2
APP_INGEST_ORDERED_INSERT=false

# Reconciliation Performance Tuning
APP_RECON_PARTNER_BATCH_SIZE=10000
APP_RECON_RESULT_BATCH_SIZE=20000
APP_RECON_RESULT_WRITE_WORKERS=2
APP_RECON_RESULT_ORDERED_INSERT=false

# AI Analysis Layer (OpenAI-compatible) Configuration
# All fields correspond to the AnalysisConfig settings (prefixed with AI_)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_ENDPOINT=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key_here
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-4o-mini
AI_FALLBACK_ENDPOINT=
AI_FALLBACK_API_KEY=
AI_TIMEOUT=30
AI_MAX_RETRIES=2
AI_JSON_MODE=true
AI_CACHE_TTL_SECONDS=300
AI_CACHE_ENABLED=true
AI_ALERT_MISMATCH_RATE_THRESHOLD=5.0
AI_ALERT_MISSING_COUNT_THRESHOLD=10

BACKEND_API_URL=http://localhost:8000
